# MongoDB trebuie să ruleze ca replica set (ex: MongoDB Atlas) — Prisma o cere pentru tranzacții.
DATABASE_URL="mongodb+srv://USER:PAROLA@cluster0.exemplu.mongodb.net/iron-vault?retryWrites=true&w=majority"

# Adresa publică a site-ului (canonical, Open Graph, JSON-LD, robots.txt, sitemap.xml).
NEXT_PUBLIC_SITE_URL="https://faust-ten.vercel.app"

# Comenzile din coș sunt trimise pe Telegram (app/actions.ts → placeOrder).
# Tokenul botului de la @BotFather și ID-ul chatului care primește comenzile. Doar pe server; nu le pune în cod.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Conturi și sesiuni (lib/auth): cheia cu care se semnează sesiunile, cel puțin 32 de caractere aleatorii
# (ex: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`). Fără ea, autentificarea rămâne închisă.
# Tranzitoriu: dacă AUTH_SECRET lipsește, se folosește vechea ADMIN_SESSION_SECRET (va fi eliminată).
# Primul administrator: ADMIN_EMAIL, ADMIN_NAME și ADMIN_PASSWORD doar pentru comanda `npm run admin:create`.
AUTH_SECRET=""
