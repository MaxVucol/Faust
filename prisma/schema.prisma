generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Text stored once per language. Any language may be missing; readers fall back (lib/localized-text.ts).
type LocalizedText {
  ro String?
  ru String?
  en String?
}

model Game {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String    @unique
  description    LocalizedText
  price          Float
  discountPrice  Float?
  discountEndsAt DateTime?
  coverImage     String
  /// Optional landscape image for home-page cards only; falls back to the first screenshot.
  cardImage      String?
  /// Optional portrait cover for the game page only; falls back to coverImage.
  pageCoverImage String?
  screenshots    String[]
  genres         String[]
  platforms      String[]
  rating         Float
  releaseDate    DateTime
  developer      String
  publisher      String
  stock          Int
  featured       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())
}
