generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Text stored once per language. Any language may be missing; readers fall back (lib/localized-text.ts).
type LocalizedText {
  ro String?
  ru String?
  en String?
}

/// One purchasable version of a game (a platform, optionally an edition). Every field except the
/// platform is optional: unknown activation/region/edition stay empty instead of being guessed, and a
/// missing price or sale falls back to the game's own price and sale.
type GameVariant {
  platform         String
  edition          String?
  /// Where the key is redeemed, e.g. "Steam" or "PlayStation Store".
  activation       String?
  region           String?
  price            Float?
  discountPrice    Float?
  discountStartsAt DateTime?
  discountEndsAt   DateTime?
  stock            Int?
}

/// One column of PC system requirements. Every field is optional: what the publisher doesn't list
/// stays empty.
type RequirementSet {
  os        String?
  processor String?
  memory    String?
  graphics  String?
  directX   String?
  storage   String?
}

/// Verified PC requirements for a game, with the page they were copied from. Absent when no
/// verified requirements exist; never filled from a template or another game.
type SystemRequirements {
  source      String
  minimum     RequirementSet?
  recommended RequirementSet?
}

model Game {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  slug               String              @unique
  description        LocalizedText
  price              Float
  discountPrice      Float?
  /// A sale runs from discountStartsAt (immediately when unset) until discountEndsAt.
  discountStartsAt   DateTime?
  discountEndsAt     DateTime?
  /// Purchasable versions. When empty, each entry of `platforms` is one variant at the game's price.
  variants           GameVariant[]
  coverImage         String
  /// Optional landscape image for home-page cards only; falls back to the first screenshot.
  cardImage          String?
  /// Optional portrait cover for the game page only; falls back to coverImage.
  pageCoverImage     String?
  screenshots        String[]
  genres             String[]
  platforms          String[]
  /// The store's own score (shown as "The Iron Vault rating"). Empty until the store has rated
  /// the game; never filled with an invented number.
  rating             Float?
  releaseDate        DateTime
  developer          String
  publisher          String
  stock              Int
  systemRequirements SystemRequirements?
  featured           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())
}

/// An account of the site. Only an active account with role "admin" may use the admin panel; blocked
/// accounts can't sign in. Admins are created with `npm run admin:create`; never seeded.
model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  name         String
  /// scrypt hash (lib/auth/password.ts); the password itself is never stored. Missing for an account
  /// created with Google (it has no password, so the password sign-in never accepts it).
  passwordHash String?
  /// The linked Google account's permanent id (OpenID Connect `sub`, lib/auth/google.ts). Missing = not linked.
  /// One Google account belongs to one user; kept unique by the code (there is no index).
  googleId     String?
  /// "admin" or "user".
  role         String    @default("user")
  /// "active" or "blocked".
  status       String    @default("active")
  lastLoginAt  DateTime?
  /// Moves on to end every session of the account (lib/auth/user.ts revokeSessions). Missing = 0.
  sessionVersion Int?
  /// Orders placed while signed in (Order.userId). Not stored on the user document.
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// One line of a placed order, priced by the server when the order was sent (MDL).
type OrderItem {
  slug      String
  title     String
  platform  String
  edition   String?
  quantity  Int
  unitPrice Float
  sum       Float
}

/// An order from the checkout, saved once the shop has been notified (app/actions.ts placeOrder).
model Order {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  /// "IV-…", the number the customer sees.
  number        String      @unique
  /// The account the order was placed from; null for a guest checkout. Never set from an email match.
  userId        String?     @db.ObjectId
  /// Deleting the account keeps its orders, as guest orders.
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String
  comment       String?
  items         OrderItem[]
  totalMdl      Float
  /// The display currency the customer had chosen (prices are charged in MDL).
  currency      String
  locale        String
  /// "new", "processing", "completed" or "cancelled".
  status        String      @default("new")
  /// "unpaid", "paid" or "refunded".
  paymentStatus String      @default("unpaid")
  /// The shop's Telegram notification (lib/orders.ts): when it was delivered, and how many times it was
  /// tried. The order exists without it; one not delivered can be sent again (npm run orders:notify).
  /// Both missing on orders from before notifications were tracked (those were sent before saving).
  notifiedAt     DateTime?
  notifyAttempts Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

/// A customer's profile picture (lib/auth/avatar.ts): a small square image, re-encoded in the browser to
/// 256×256 and checked on the server (real JPEG/PNG/WebP, size, dimensions). Its id IS the owner's user
/// id, so an account has at most one and a request can only ever reach its own (no extra index needed).
/// Kept out of the User document so the session's user query never loads image bytes.
model Avatar {
  id        String   @id @map("_id") @db.ObjectId
  data      Bytes
  /// MIME type of `data`: image/jpeg, image/png or image/webp.
  type      String
  updatedAt DateTime @updatedAt
}
